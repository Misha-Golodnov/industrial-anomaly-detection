      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stored_di" bpmnElement="Flow_Stored">
        <di:waypoint x="1025" y="525"/>
        <di:waypoint x="1080" y="525"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Alarm_di" bpmnElement="Flow_Alarm">
        <di:waypoint x="1130" y="525"/>
        <di:waypoint x="1190" y="525"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="494" width="40" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Normal_di" bpmnElement="Flow_Normal">
