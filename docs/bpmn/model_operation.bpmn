<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TEP_Operation" targetNamespace="https://github.com/Misha-Golodnov/industrial-anomaly-detection/bpmn/hw2" exporter="Codex documentation generator" exporterVersion="1.0">
  <bpmn:error id="Error_Calculation" name="Ошибка расчёта" errorCode="inference_error"/>
  <bpmn:collaboration id="Collaboration_TEP">
    <bpmn:participant id="Participant_TEP" name="Мониторинг состояния установки" processRef="Process_TEP"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_TEP" name="Анализ нового прогона и обработка тревоги" isExecutable="false">
    <bpmn:documentation>Проектируемая пакетная эксплуатация прототипа. Один экземпляр процесса на входной файл. Заранее утверждены обученная модель, скейлер, порядок каналов, точный порог и параметры EWMA. Текущая реализация в ноутбуке не содержит сервиса уведомлений и пользовательского интерфейса. Истинные метки отказа не используются при эксплуатации. Ошибку расчёта нельзя трактовать как норму.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_TEP">
      <bpmn:lane id="Lane_Data" name="Модуль подготовки данных">
        <bpmn:flowNodeRef>Start_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DataError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Model" name="Модуль детекции">
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ScoreError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Alarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScoreError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ScoreError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Инженер / оператор">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FalseAlarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reviewed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_File" name="Получен файл">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Проверить каналы, отсчёты и качество данных">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Data" name="Данные корректны и достаточны?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_DataOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Prepare" name="Применить скейлер; сформировать окна 24 x 52, шаг 8">
      <bpmn:incoming>Flow_DataOK</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DataError" name="Зарегистрировать проблему данных">
      <bpmn:incoming>Flow_DataBad</bpmn:incoming>
      <bpmn:outgoing>Flow_DataEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DataError" name="Данные отклонены">
      <bpmn:incoming>Flow_DataEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Score" name="Рассчитать скоры; сбросить EWMA между прогонами">
      <bpmn:incoming>Flow_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Scored</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ScoreError" name="Ошибка расчёта" attachedToRef="Task_Score" cancelActivity="true">
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDefinition_Score" errorRef="Error_Calculation"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Store" name="Сохранить оценки, порог и версию модели">
      <bpmn:incoming>Flow_Scored</bpmn:incoming>
      <bpmn:outgoing>Flow_Stored</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Alarm" name="Есть превышение порога?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Stored</bpmn:incoming>
      <bpmn:outgoing>Flow_Alarm</bpmn:outgoing>
      <bpmn:outgoing>Flow_Normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Notify" name="Подготовить тревогу с подозрительными окнами">
      <bpmn:incoming>Flow_Alarm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScoreError" name="Записать ошибку; уведомить инженера">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ScoreError" name="Расчёт не выполнен">
      <bpmn:incoming>Flow_ErrorEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Normal" name="Отчёт сохранён; тревог нет">
      <bpmn:incoming>Flow_Normal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Review" name="Проверить тревожные окна и показания">
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Reviewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Confirm" name="Проблема подтверждена?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Reviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Incident" name="Зарегистрировать инцидент; передать на обслуживание">
      <bpmn:incoming>Flow_Confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_IncidentDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FalseAlarm" name="Зафиксировать ложную тревогу">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_FalseDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_IncidentDone</bpmn:incoming>
      <bpmn:incoming>Flow_FalseDone</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Reviewed" name="Проверка завершена">
      <bpmn:incoming>Flow_Complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_File" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Validate" targetRef="Gateway_Data"/>
    <bpmn:sequenceFlow id="Flow_DataOK" sourceRef="Gateway_Data" targetRef="Task_Prepare" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">data_valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DataBad" sourceRef="Gateway_Data" targetRef="Task_DataError" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not data_valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DataEnd" sourceRef="Task_DataError" targetRef="End_DataError"/>
    <bpmn:sequenceFlow id="Flow_Ready" sourceRef="Task_Prepare" targetRef="Task_Score"/>
    <bpmn:sequenceFlow id="Flow_Scored" sourceRef="Task_Score" targetRef="Task_Store"/>
    <bpmn:sequenceFlow id="Flow_Stored" sourceRef="Task_Store" targetRef="Gateway_Alarm"/>
    <bpmn:sequenceFlow id="Flow_Alarm" sourceRef="Gateway_Alarm" targetRef="Task_Notify" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_alarm</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Normal" sourceRef="Gateway_Alarm" targetRef="End_Normal" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not has_alarm</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Error" sourceRef="Boundary_ScoreError" targetRef="Task_ScoreError"/>
    <bpmn:sequenceFlow id="Flow_ErrorEnd" sourceRef="Task_ScoreError" targetRef="End_ScoreError"/>
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Task_Notify" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="Flow_Reviewed" sourceRef="Task_Review" targetRef="Gateway_Confirm"/>
    <bpmn:sequenceFlow id="Flow_Confirmed" sourceRef="Gateway_Confirm" targetRef="Task_Incident" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">incident_confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_Confirm" targetRef="Task_FalseAlarm" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not incident_confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IncidentDone" sourceRef="Task_Incident" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_FalseDone" sourceRef="Task_FalseAlarm" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_Complete" sourceRef="Gateway_Merge" targetRef="End_Reviewed"/>
    <bpmn:dataObject id="DataObject_Model" name="Утверждённый пакет модели"/>
    <bpmn:dataObjectReference id="Data_Model" dataObjectRef="DataObject_Model" name="Утверждённый пакет модели: скейлер, детекторы, квантили, EWMA и точный порог"/>
    <bpmn:association id="Assoc_Scaler" sourceRef="Data_Model" targetRef="Task_Prepare" associationDirection="One"/>
    <bpmn:association id="Assoc_Model" sourceRef="Data_Model" targetRef="Task_Score" associationDirection="One"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TEP">
    <bpmndi:BPMNPlane id="Plane_TEP" bpmnElement="Collaboration_TEP">
      <bpmndi:BPMNShape id="Participant_TEP_di" bpmnElement="Participant_TEP" isHorizontal="true">
        <dc:Bounds x="45" y="145" width="1970" height="855"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Data_di" bpmnElement="Lane_Data" isHorizontal="true">
        <dc:Bounds x="80" y="145" width="1935" height="255"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Model_di" bpmnElement="Lane_Model" isHorizontal="true">
        <dc:Bounds x="80" y="400" width="1935" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operator_di" bpmnElement="Lane_Operator" isHorizontal="true">
        <dc:Bounds x="80" y="700" width="1935" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_File_di" bpmnElement="Start_File">
        <dc:Bounds x="162" y="232" width="36" height="36"/>
