        <dc:Bounds x="600" y="205" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataError_di" bpmnElement="Task_DataError">
        <dc:Bounds x="245" y="310" width="180" height="70"/>
      </bpmndi:BPMNShape>
