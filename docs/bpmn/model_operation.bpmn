        <di:waypoint x="245" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="425" y="250"/>
        <di:waypoint x="480" y="250"/>
      </bpmndi:BPMNEdge>
