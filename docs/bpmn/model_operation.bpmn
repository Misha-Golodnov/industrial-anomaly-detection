        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DataBad_di" bpmnElement="Flow_DataBad">
        <di:waypoint x="505" y="275"/>
        <di:waypoint x="505" y="345"/>
        <di:waypoint x="425" y="345"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="457" y="296" width="40" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DataEnd_di" bpmnElement="Flow_DataEnd">
        <di:waypoint x="245" y="345"/>
        <di:waypoint x="198" y="345"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ready_di" bpmnElement="Flow_Ready">
        <di:waypoint x="695" y="295"/>
        <di:waypoint x="695" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Scored_di" bpmnElement="Flow_Scored">
        <di:waypoint x="790" y="525"/>
