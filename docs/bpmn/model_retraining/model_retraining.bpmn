<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TEP_Retraining" targetNamespace="https://github.com/Misha-Golodnov/industrial-anomaly-detection/bpmn/retraining" exporter="docs generator" exporterVersion="1.0">
  <bpmn:message id="Message_Request" name="Запрос на переобучение или смену модели"/>
  <bpmn:error id="Error_Train" name="Сбой обучения" errorCode="training_error"/>
  <bpmn:collaboration id="Collaboration_Retrain">
    <bpmn:participant id="Participant_Retrain" name="Проектное переобучение и смена модели" processRef="Process_Retrain"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Retrain" name="Проектный процесс переобучения или смены модели" isExecutable="false">
    <bpmn:documentation>Целевой процесс, не реализованный в текущем коде как автоматический цикл. Один экземпляр соответствует одному запуску переобучения. Текущая модель остаётся в эксплуатации до утверждения и проверки новой версии. Значения порогов триггеров, критериев приёмки и лимитов цикла являются условными проектными значениями, а не измеренными показателями системы.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Retrain">
      <bpmn:lane id="Lane_Monitor" name="Мониторинг">
        <bpmn:flowNodeRef>Start_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Drift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TrainStopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ML" name="ML-пайплайн">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calibrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Better</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KeepCurrent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KeepCurrent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_TrainError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_TrainTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="ML-инженер">
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Deploy" name="Деплой">
        <bpmn:flowNodeRef>Task_Package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Shadow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Shadow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Switch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RolledBack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Timer" name="Квартальный пересмотр">
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Quarter"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P3M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Drift" name="Сработал порог триггера">
      <bpmn:outgoing>Flow_T2</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CondDef_Drift"><bpmn:condition xsi:type="bpmn:tFormalExpression">false_alarm_share &gt; 0.40 OR any(abs(z) &gt; 4) OR new_runs &gt;= 100</bpmn:condition></bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Request" name="Запрос на смену модели">
      <bpmn:outgoing>Flow_T3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Request" messageRef="Message_Request"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Trigger">
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:incoming>Flow_T2</bpmn:incoming>
      <bpmn:incoming>Flow_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Register" name="Записать триггер и версию модели">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Defer" name="Отложить; копить данные">
      <bpmn:incoming>Flow_DataNo</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Deferred" name="Переобучение отложено">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_TrainStop" name="Записать причину; уведомить в Telegram">
      <bpmn:incoming>Flow_TrainErr</bpmn:incoming>
      <bpmn:incoming>Flow_TrainTime</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_TrainStopped" name="Обучение прервано; текущая модель в работе">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Collect" name="Собрать доступные прогоны">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:property id="Property_DA_Journal" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DA_Journal"><bpmn:sourceRef>Data_Journal</bpmn:sourceRef><bpmn:targetRef>Property_DA_Journal</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Enough" name="Данных достаточно?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_DataNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Split" name="Разделить: train / val / holdout">
      <bpmn:incoming>Flow_DataYes</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Loop">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Train" name="Обучить модель-кандидат">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Calibrate" name="Калибровать порог на val">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Evaluate" name="Оценить кандидата на holdout">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Accept" name="Критерии приёмки выполнены?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AcceptNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Compare" name="Сравнить с текущей моделью">
      <bpmn:incoming>Flow_AcceptYes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Better" name="Кандидат лучше текущей?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_BetterNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_BetterYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Budget" name="Лимит исчерпан?">
      <bpmn:incoming>Flow_AcceptNo</bpmn:incoming>
      <bpmn:outgoing>Flow_BudgetNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_BudgetYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Adjust" name="Следующая конфигурация">
      <bpmn:incoming>Flow_BudgetNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KeepCurrent" name="Оставить текущую модель">
      <bpmn:incoming>Flow_BudgetYes</bpmn:incoming>
      <bpmn:incoming>Flow_BetterNo</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_KeepCurrent" name="Текущая модель сохранена">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Approve" name="Утвердить новую версию">
      <bpmn:incoming>Flow_BetterYes</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Утверждено?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject" name="Записать отказ и причину">
      <bpmn:incoming>Flow_ApprNo</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Rejected" name="Кандидат отклонён">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Package" name="Сохранить версию пакета">
      <bpmn:incoming>Flow_ApprYes</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Package"><bpmn:targetRef>Data_Package</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Shadow" name="Теневой режим на новых файлах">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Shadow" name="Регрессии нет?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_ShadowYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ShadowNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Switch" name="Включить новую версию">
      <bpmn:incoming>Flow_ShadowYes</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Registry"><bpmn:targetRef>Store_Registry</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_Docs" name="Обновить model card и журнал">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Deployed" name="Новая версия в эксплуатации">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Rollback" name="Откат к прежней версии">
      <bpmn:incoming>Flow_ShadowNo</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_RolledBack" name="Кандидат не внедрён">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_TrainError" name="Сбой обучения" attachedToRef="Task_Train" cancelActivity="true">
      <bpmn:outgoing>Flow_TrainErr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Train" errorRef="Error_Train"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_TrainTimeout" name="Лимит времени 8 ч" attachedToRef="Task_Train" cancelActivity="true">
      <bpmn:outgoing>Flow_TrainTime</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Train"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_T1" sourceRef="Start_Timer" targetRef="Gateway_Trigger"/>
    <bpmn:sequenceFlow id="Flow_T2" sourceRef="Start_Drift" targetRef="Gateway_Trigger"/>
    <bpmn:sequenceFlow id="Flow_T3" sourceRef="Start_Request" targetRef="Gateway_Trigger"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Gateway_Trigger" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Register" targetRef="Task_Collect"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Collect" targetRef="Gateway_Enough"/>
    <bpmn:sequenceFlow id="Flow_DataNo" name="Нет" sourceRef="Gateway_Enough" targetRef="Task_Defer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">new_runs &lt; 100 OR data_quality_failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Defer" targetRef="End_Deferred"/>
    <bpmn:sequenceFlow id="Flow_DataYes" name="Да" sourceRef="Gateway_Enough" targetRef="Task_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">new_runs &gt;= 100 AND data_quality_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Split" targetRef="Gateway_Loop"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Loop" targetRef="Task_Train"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Train" targetRef="Task_Calibrate"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Calibrate" targetRef="Task_Evaluate"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Evaluate" targetRef="Gateway_Accept"/>
    <bpmn:sequenceFlow id="Flow_AcceptYes" name="Да" sourceRef="Gateway_Accept" targetRef="Task_Compare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all_acceptance_criteria_met</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AcceptNo" name="Нет" sourceRef="Gateway_Accept" targetRef="Gateway_Budget">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">NOT all_acceptance_criteria_met</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BudgetNo" name="Нет" sourceRef="Gateway_Budget" targetRef="Task_Adjust">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">iteration &lt; 5 AND no_improvement_streak &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Loop" sourceRef="Task_Adjust" targetRef="Gateway_Loop"/>
    <bpmn:sequenceFlow id="Flow_BudgetYes" name="Да" sourceRef="Gateway_Budget" targetRef="Task_KeepCurrent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">iteration &gt;= 5 OR no_improvement_streak &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BetterNo" name="Нет" sourceRef="Gateway_Better" targetRef="Task_KeepCurrent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">NOT candidate_better_than_champion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_KeepCurrent" targetRef="End_KeepCurrent"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Compare" targetRef="Gateway_Better"/>
    <bpmn:sequenceFlow id="Flow_BetterYes" name="Да" sourceRef="Gateway_Better" targetRef="Task_Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidate_better_than_champion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TrainErr" sourceRef="Boundary_TrainError" targetRef="Task_TrainStop"/>
    <bpmn:sequenceFlow id="Flow_TrainTime" sourceRef="Boundary_TrainTimeout" targetRef="Task_TrainStop"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_TrainStop" targetRef="End_TrainStopped"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Approve" targetRef="Gateway_Approved"/>
    <bpmn:sequenceFlow id="Flow_ApprNo" name="Нет" sourceRef="Gateway_Approved" targetRef="Task_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Reject" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_ApprYes" name="Да" sourceRef="Gateway_Approved" targetRef="Task_Package">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Package" targetRef="Task_Shadow"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Shadow" targetRef="Gateway_Shadow"/>
    <bpmn:sequenceFlow id="Flow_ShadowYes" name="Да" sourceRef="Gateway_Shadow" targetRef="Task_Switch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">shadow_no_regression</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ShadowNo" name="Нет" sourceRef="Gateway_Shadow" targetRef="Task_Rollback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">NOT shadow_no_regression</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Switch" targetRef="Task_Docs"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Docs" targetRef="End_Deployed"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Rollback" targetRef="End_RolledBack"/>
    <bpmn:dataObject id="DataObject_Journal" name="Журнал тревог и решений инженера"/>
    <bpmn:dataObject id="DataObject_Package" name="Пакет модели-кандидата"/>
    <bpmn:dataObjectReference id="Data_Journal" dataObjectRef="DataObject_Journal" name="Журнал тревог и решений инженера"/>
    <bpmn:dataObjectReference id="Data_Package" dataObjectRef="DataObject_Package" name="Пакет модели-кандидата"/>
    <bpmn:dataStoreReference id="Store_Registry" dataStoreRef="DataStore_Registry" name="Реестр версий модели"/>
    <bpmn:textAnnotation id="Annot_Triggers"><bpmn:text>Условные проектные пороги триггеров: плановый пересмотр — раз в квартал; доля ложных тревог &gt; 40%; |z| &gt; 4; накоплено 100 прогонов; также возможен запрос на смену модели.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annot_Accept"><bpmn:text>Условные проектные критерии приёмки на holdout: доля ложных тревог по окнам ≤ 1,5%; нормальных прогонов с тревогой ≤ 30%; обнаружение неисправностей ≥ 98%; AUROC ≥ 0,80.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annot_Stop"><bpmn:text>Условные проектные лимиты цикла: не более 5 конфигураций; остановка после 2 итераций без улучшения; лимит обучения — 8 часов. Сбой обучения также завершает запуск.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annot_Shadow"><bpmn:text>Теневой режим, его параметры, реестр версий модели, роль владельца модели и автоматический цикл переобучения — проектные элементы, которых нет в текущем коде.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Triggers" sourceRef="Annot_Triggers" targetRef="Task_Register"/>
    <bpmn:association id="Assoc_Accept" sourceRef="Annot_Accept" targetRef="Gateway_Accept"/>
    <bpmn:association id="Assoc_Stop" sourceRef="Annot_Stop" targetRef="Gateway_Budget"/>
    <bpmn:association id="Assoc_Shadow" sourceRef="Annot_Shadow" targetRef="Task_Shadow"/>
  </bpmn:process>
  <bpmn:dataStore id="DataStore_Registry" name="Реестр версий модели (проект; нет в коде)"/>
  <bpmndi:BPMNDiagram id="Diagram_Retrain">
